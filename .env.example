# คัดลอกไฟล์นี้เป็น .env แล้วใส่ค่าจริง (ห้าม commit ไฟล์ .env ลง Git เด็ดขาด)

# ==============================================================================
# 1. โหมดการทำงานของเว็บเซิร์ฟเวอร์และคุกกี้ (เลือกเปิดใช้โหมดใดโหมดหนึ่ง)
# ==============================================================================

# --- โหมด A: ทดสอบในเครื่อง (Local Development) ---
# เปิดใช้งานเฉพาะเครื่องนี้ผ่าน http://127.0.0.1:8000 (ไม่ต้องมี HTTPS)
HOST=127.0.0.1
PORT=8000
COOKIE_SECURE=0

# --- โหมด B: ขึ้นเซิร์ฟเวอร์จริงที่มี HTTPS (Production Server) ---
# เมื่อนำขึ้นเซิร์ฟเวอร์จริงที่มี Reverse Proxy / HTTPS ให้สลับมาใช้ค่าด้านล่างนี้แทน:
# HOST=0.0.0.0
# PORT=8000
# COOKIE_SECURE=1

SESSION_COOKIE_NAME=badminton_session

# ==============================================================================
# 2. ความปลอดภัยของรหัส OTP (HMAC-SHA256)
# ==============================================================================
# ค่าลับสุ่มความยาวอย่างน้อย 32 ตัวอักษร ใช้เป็นคีย์ทำ HMAC-SHA256 ของรหัส OTP ในฐานข้อมูล
# วิธีสร้างค่าลับสุ่มด้วยคำสั่ง Python:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
OTP_SECRET=

# ==============================================================================
# 3. ตั้งค่าอีเมลผู้ส่ง (SMTP สำหรับส่งรหัส OTP / ใบเสร็จ PDF / แจ้งเลขพัสดุ / สรุปสต็อกต่ำ)
# ==============================================================================
# เซิร์ฟเวอร์ SMTP (ค่าเริ่มต้นคือ Gmail: smtp.gmail.com)
SMTP_HOST=smtp.gmail.com

# พอร์ต SMTP: รองรับทั้ง 587 (STARTTLS) และ 465 (SSL/TLS)
SMTP_PORT=587

# อีเมลผู้ส่ง (เช่น example_shop@gmail.com — ผู้ใช้กรอกเอง)
SMTP_USER=

# รหัสผ่านแอปของ Gmail (App Password ความยาว 16 ตัวอักษร ไม่ใช่รหัสผ่านเข้าอีเมลปกติ)
# วิธีสร้างสั้น ๆ: เข้าบัญชี Google -> Security (ความปลอดภัย) -> เปิด 2-Step Verification (การยืนยันแบบ 2 ขั้นตอน)
# -> ค้นหาเมนู "App passwords" (รหัสผ่านสำหรับแอป) -> สร้างรหัสใหม่แล้วนำ 16 ตัวอักษรมาใส่ที่นี่ (ไม่ต้องเว้นวรรค)
SMTP_PASSWORD=

# รองรับตัวแปรชื่อเดิม SMTP_PASS เพื่อความเข้ากันได้ย้อนหลัง (ใส่ที่ SMTP_PASSWORD ช่องเดียวได้)
SMTP_PASS=

# ชื่อที่แสดงเป็นผู้ส่งในหัวอีเมล (เช่น AI.HERE BADᴍᴛ-Zone)
SMTP_FROM_NAME=AI.HERE BADᴍᴛ-Zone

# อีเมลผู้ส่งในหัว From (ถ้าเว้นว่างไว้ ระบบจะใช้ค่าจาก SMTP_USER อัตโนมัติ)
SMTP_FROM=

# บัญชีเจ้าของร้านเริ่มต้น
OWNER_EMAIL=
OWNER_INITIAL_PASSWORD=

# เปิด/ปิดการส่งอีเมลแจ้งเตือนอัตโนมัติในส่วนอื่น ๆ (1 = เปิด, 0 = ปิด)
RECEIPT_EMAIL_ENABLED=1
SHIPPED_EMAIL_ENABLED=1
LOW_STOCK_EMAIL_ENABLED=1

# ==============================================================================
# 4. ตั้งค่า AI แชทบอท (Gemini) และตัวเลือกเสริมอื่น ๆ
# ==============================================================================
# คีย์ Gemini API (ถ้าเว้นว่าง แอปยังทำงานได้โดยใช้ข้อความตอบกลับสำรองอัตโนมัติ)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# เวลาไม่มีการใช้งาน (นาที) ก่อนล็อกหน้าจออัตโนมัติสำหรับเครื่องหน้าร้าน (Admin/Owner)
STAFF_IDLE_TIMEOUT_MINUTES=30

# ทางเลือกเสริม: ส่งออกรายงานไปยัง Google Sheets
GOOGLE_SERVICE_ACCOUNT_FILE=
GOOGLE_SHEET_ID=
